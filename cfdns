#!/usr/bin/env bash
set -euo pipefail
source /root/.cfdns.env
API="https://api.cloudflare.com/client/v4"
Z="$CLOUDFLARE_ZONE_ID"
CADDYFILE="/etc/caddy/Caddyfile"

if [ -t 1 ]; then
  N='\033[0m'; C='\033[1;36m'; G='\033[1;32m'; R='\033[1;31m'
  Y='\033[1;33m'; M='\033[1;35m'; W='\033[1;37m'; D='\033[0;90m'
else N=;C=;G=;R=;Y=;M=;W=;D=; fi
BW=38
row() { local t="$1" s="${2:-$1}" l; l=$(( (BW-${#t})/2 )); printf "%*s%b\n" "$l" "" "$s"; }
banner() {
  local bar; bar=$(printf '═%.0s' $(seq 1 $BW))
  printf "${C}%s${N}\n" "$bar"
  row "CLOUDFLARE DNS RECORDER" "${C}𝗖𝗟𝗢𝗨𝗗𝗙𝗟𝗔𝗥𝗘 𝗗𝗡𝗦 𝗥𝗘𝗖𝗢𝗥𝗗𝗘𝗥${N}"
  echo
  row "created & maintained by" "${D}𝘤𝘳𝘦𝘢𝘵𝘦𝘥 & 𝘮𝘢𝘪𝘯𝘵𝘢𝘪𝘯𝘦𝘥 𝘣𝘺${N}"
  row "XSPACE TECH DEVS" "${M}𝓧𝓢𝓟𝓐𝓒𝓔 𝓣𝓔𝓒𝓗 𝓓𝓔𝓥𝓢${N}"
  echo
  row "GitHub: Casper-Tech-ke" "${D}𝗚𝗶𝘁𝗛𝘂𝗯:${N} ${G}𝗖𝗮𝘀𝗽𝗲𝗿-𝗧𝗲𝗰𝗵-𝗸𝗲${N}"
  printf "${C}%s${N}\n" "$bar"
}
res() { local j; j=$(cat); if [ "$(echo "$j" | jq -r '.success')" = "true" ]; then printf "${G}✓${N} %s\n" "$1"; else printf "${R}✗${N} Failed: %s\n" "$(echo "$j" | jq -r '.errors[0].message // "unknown error"')"; exit 1; fi; }
mode() { if [ "$1" = "true" ]; then echo "proxied (orange cloud)"; else echo "DNS only (grey cloud)"; fi; }
err() { printf "${R}✗${N} %s\n" "$1" >&2; exit 1; }

cf() { curl -s -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" -H "Content-Type: application/json" "$@"; }
confirm() { read -rp "Are you sure you want to $1? (type yes to continue): " ans; [ "$ans" = "yes" ]; }

PROXY=""; TYPE=""; PRIO=""; MATCH=""; KEEP=""; RETRY=""; PCHECK_LOC=""; POS=()
parse() {
  POS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --proxy|--proxied|-p) PROXY=true ;;
      --dns-only|--no-proxy|-d) PROXY=false ;;
      --type|-t) TYPE="${2:?--type needs a value}"; shift ;;
      --priority|--prio) PRIO="${2:?--priority needs a number}"; shift ;;
      --match|-m) MATCH="${2:?--match needs text}"; shift ;;
      --keep-dns) KEEP=1 ;;
      --retry) RETRY=1 ;;
      *) POS+=("$1") ;;
    esac
    shift
  done
}

ZONE=$(cf "$API/zones/$Z" | jq -r '.result.name // empty')
[ -z "$ZONE" ] && err "Could not read your zone. Re-run the installer to reset your token and Zone ID."

fqdn() {
  local n="${1,,}"; n="${n%.}"
  if [ "$n" = "@" ] || [ "$n" = "$ZONE" ]; then echo "$ZONE"
  elif [[ "$n" == *".$ZONE" ]]; then echo "$n"
  elif [[ "$n" != *.* ]]; then echo "$n.$ZONE"
  else err "Refusing: '$1' is outside your zone ($ZONE)."
  fi
}

find() {
  cf "$API/zones/$Z/dns_records?name=$1&per_page=100${TYPE:+&type=${TYPE^^}}" \
    | jq -r --arg m "$MATCH" '.result[] | select($m=="" or (.content|contains($m))) | [.id,.type,.content] | @tsv'
}
pick() {
  local rows n
  rows=$(find "$1"); n=$(printf "%s" "$rows" | grep -c . || true)
  if [ "$n" -eq 0 ]; then err "Not found: $1"
  elif [ "$n" -gt 1 ]; then
    printf "${R}✗${N} %s has %s matching records. Narrow it with --type and/or --match:\n" "$1" "$n" >&2
    printf "%s\n" "$rows" | cut -f2,3 | sed 's/^/     /' >&2
    exit 1
  fi
  printf "%s\n" "$rows"
}

# --- Caddy helpers ---
need_caddy() {
  command -v caddy >/dev/null 2>&1 || err "Caddy is not installed. Run: apt install -y caddy"
  [ -f "$CADDYFILE" ] || err "$CADDYFILE not found."
}
caddy_backup()  { cp "$CADDYFILE" "$CADDYFILE.cfdns.bak"; }
caddy_restore() { cp "$CADDYFILE.cfdns.bak" "$CADDYFILE"; }
caddy_apply() {
  if ! caddy validate --config "$CADDYFILE" --adapter caddyfile >/dev/null 2>&1; then
    caddy_restore; err "Caddy rejected the new config. Change rolled back."
  fi
  if ! systemctl reload caddy; then
    caddy_restore; systemctl reload caddy || true
    err "Caddy failed to reload. Change rolled back."
  fi
}

# --- Certificate and proxy helpers ---
vps_ip() { curl -s --max-time 8 https://api.ipify.org; }
# true when https://NAME answers with a valid certificate, tested straight against IP
cert_ok() { curl -sS -o /dev/null --max-time 8 --resolve "$1:443:$2" "https://$1" >/dev/null 2>&1; }
wait_cert() {
  local n=0 max="${3:-90}"
  printf "  waiting for the certificate"
  while [ "$n" -lt "$max" ]; do
    if cert_ok "$1" "$2"; then printf "\n"; return 0; fi
    printf "."; sleep 5; n=$((n+5))
  done
  printf "\n"; return 1
}
cert_diag() {
  local n="$1" logs until_txt
  logs=$(journalctl -u caddy --since "20 minutes ago" --no-pager 2>/dev/null | grep -F "$n" | grep -iE 'error|rateLimited' | grep -vi zerossl | tail -3 || true)
  if printf "%s" "$logs" | grep -q rateLimited; then
    until_txt=$(printf "%s" "$logs" | grep -o 'retry after [0-9-]* [0-9:]* UTC' | tail -1 || true)
    printf "${Y}!${N} Let's Encrypt is rate limiting this name (%s).\n" "${until_txt:-wait about an hour}"
    printf "${D}   Caddy retries on its own. Check later with: cfdns cert %s${N}\n" "$n"
  elif [ -n "$logs" ]; then
    printf "  Last Caddy errors:\n"; printf "%s\n" "$logs" | cut -c1-220 | sed 's/^/    /'
    printf "${D}   A common cause is a proxied (orange cloud) record. Keep it DNS only until the certificate works.${N}\n"
  else
    printf "${D}   No error logged yet. Caddy may still be working. Check again with: cfdns cert %s${N}\n" "$n"
  fi
}
cert_info() {
  local out exp iss days=""
  out=$(curl -svI --max-time 10 --resolve "$1:443:$2" "https://$1" 2>&1 >/dev/null || true)
  exp=$(printf "%s" "$out" | sed -n 's/^\*  *expire date: //p' | head -1)
  iss=$(printf "%s" "$out" | sed -n 's/^\*  *issuer: //p' | head -1)
  [ -n "$exp" ] && days=$(( ( $(date -d "$exp" +%s) - $(date +%s) ) / 86400 ))
  printf "${G}✓${N} Valid HTTPS certificate for %s\n" "$1"
  printf "    issuer:  %s\n" "${iss:-unknown}"
  printf "    expires: %s%s\n" "${exp:-unknown}" "${days:+ ($days days left, Caddy renews it automatically)}"
}
set_proxy() { cf -X PATCH "$API/zones/$Z/dns_records/$1" --data "$(jq -n --argjson p "$2" '{proxied:$p}')" >/dev/null; }
# 0 = proxied site works, 1 = Cloudflare redirects it elsewhere, 2 = could not verify
proxy_check() {
  local name="$1" vps="$2" cfip="" i resp code loc lochost
  PCHECK_LOC=""
  for i in 1 2 3 4 5 6 7 8; do
    cfip=$(curl -s --max-time 8 -H 'accept: application/dns-json' "https://cloudflare-dns.com/dns-query?name=$name&type=A" | jq -r --arg v "$vps" '[.Answer[]? | select(.type==1) | .data | select(. != $v)] | .[0] // empty' 2>/dev/null || true)
    [ -n "$cfip" ] && break
    printf "."; sleep 5
  done
  [ -z "$cfip" ] && return 2
  resp=$(curl -sI --max-time 10 --resolve "$name:443:$cfip" "https://$name" 2>/dev/null || true)
  [ -z "$resp" ] && return 2
  code=$(printf "%s" "$resp" | head -1 | awk '{print $2}')
  loc=$(printf "%s" "$resp" | awk 'tolower($1)=="location:"{print $2}' | tr -d '\r' | head -1)
  if [[ "$code" =~ ^3 ]] && [[ "$loc" =~ ^https?:// ]]; then
    lochost=$(printf "%s" "$loc" | sed -E 's#^https?://([^/]+).*#\1#')
    if [ "$lochost" != "$name" ]; then PCHECK_LOC="$lochost"; return 1; fi
  fi
  return 0
}

case "${1:-}" in
  verify)
    cf "$API/user/tokens/verify" | jq -r '"Token status: \(.result.status)"'
    echo "Zone: $ZONE" ;;
  list)
    printf "${W}DNS records for %s${N}\n" "$ZONE"
    cf "$API/zones/$Z/dns_records?per_page=100" | jq -r '.result[] | "\(.type)\t\(.name)\t\(.content)\t\(if .proxied then "proxied" else "dns-only" end)\t\(if .priority != null then "prio=\(.priority)" else "-" end)"' | { column -t -s $'\t' 2>/dev/null || cat; } ;;
  add)
    parse "${@:2}"
    name=$(fqdn "${POS[0]:?usage: cfdns add NAME [VALUE] [--type T] [--priority N] [--proxy|--dns-only]}")
    type=${TYPE:-A}; type=${type^^}
    if [ -n "${POS[1]:-}" ]; then content=${POS[1]}
    elif [ "$type" = "A" ]; then content=$(curl -s https://api.ipify.org)
    else err "$type records need a value, e.g. cfdns add NAME \"value\" --type $type"
    fi
    if [ -n "$PROXY" ]; then proxied=$PROXY; else case "$type" in A|AAAA|CNAME) proxied=true ;; *) proxied=false ;; esac; fi
    case "$type" in A|AAAA|CNAME) ;; *) [ "$proxied" = true ] && err "$type records cannot be proxied" ;; esac
    prio=$PRIO; [ "$type" = "MX" ] && prio=${prio:-10}
    body=$(jq -n --arg t "$type" --arg n "$name" --arg c "$content" --argjson p "$proxied" --arg pr "$prio" \
      '{type:$t,name:$n,content:$c,proxied:$p,ttl:1} + (if $pr != "" then {priority:($pr|tonumber)} else {} end)')
    extra=""; [ -n "$prio" ] && extra=" (priority $prio)"
    cf -X POST "$API/zones/$Z/dns_records" --data "$body" | res "Added $type $name → $content$extra" ;;
  update)
    parse "${@:2}"
    name=$(fqdn "${POS[0]:?usage: cfdns update NAME NEWVALUE [--type T] [--match TEXT] [--priority N] [--proxy|--dns-only]}")
    content=${POS[1]:?missing NEW VALUE}
    IFS=$'\t' read -r id rtype rcontent <<< "$(pick "$name")"
    confirm "update $rtype $name ($rcontent) to $content" || { echo "Cancelled."; exit 1; }
    body=$(jq -n --arg c "$content" '{content:$c}')
    [ -n "$PROXY" ] && body=$(echo "$body" | jq --argjson p "$PROXY" '. + {proxied:$p}')
    [ -n "$PRIO" ] && body=$(echo "$body" | jq --argjson p "$PRIO" '. + {priority:$p}')
    cf -X PATCH "$API/zones/$Z/dns_records/$id" --data "$body" | res "Updated $rtype $name → $content" ;;
  proxy)
    parse "${@:2}"
    name=$(fqdn "${POS[0]:?usage: cfdns proxy NAME [on|off] [--type T]}")
    TYPE=${TYPE:-A}
    IFS=$'\t' read -r id rtype rcontent <<< "$(pick "$name")"
    cur=$(cf "$API/zones/$Z/dns_records/$id" | jq -r '.result.proxied')
    case "${POS[1]:-}" in
      on|true|proxy) want=true ;;
      off|false|dns) want=false ;;
      "") printf "%s is %s\n" "$name" "$(mode "$cur")"; exit 0 ;;
      *) err "Use: cfdns proxy NAME on|off" ;;
    esac
    cf -X PATCH "$API/zones/$Z/dns_records/$id" --data "$(jq -n --argjson p "$want" '{proxied:$p}')" | res "$name is now $(mode "$want")" ;;
  delete)
    parse "${@:2}"
    name=$(fqdn "${POS[0]:?usage: cfdns delete NAME [--type T] [--match TEXT]}")
    IFS=$'\t' read -r id rtype rcontent <<< "$(pick "$name")"
    confirm "delete $rtype $name ($rcontent)" || { echo "Cancelled."; exit 1; }
    cf -X DELETE "$API/zones/$Z/dns_records/$id" | res "Deleted $rtype $name" ;;
  cert)
    parse "${@:2}"
    name=$(fqdn "${POS[0]:?usage: cfdns cert NAME [--retry]}")
    ip=$(vps_ip)
    if [ -n "$RETRY" ]; then
      printf "Restarting Caddy to retry the certificate...\n"
      systemctl restart caddy; sleep 3
      wait_cert "$name" "$ip" 60 || true
    fi
    if cert_ok "$name" "$ip"; then cert_info "$name" "$ip"
    else printf "${R}✗${N} No valid certificate for %s yet\n" "$name"; cert_diag "$name"; exit 1; fi ;;
  site)
    sub="${2:-}"
    case "$sub" in
      add|remove|rm|list|ls) args=("${@:3}") ;;
      "") err "usage: cfdns site NAME PORT | cfdns site remove NAME | cfdns site list" ;;
      *) sub=add; args=("${@:2}") ;;
    esac
    need_caddy
    case "$sub" in
      add)
        parse "${args[@]}"
        name=$(fqdn "${POS[0]:?usage: cfdns site NAME PORT [--proxy]}")
        port="${POS[1]:?usage: cfdns site NAME PORT [--proxy]}"
        { [[ "$port" =~ ^[0-9]+$ ]] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ]; } || err "Port must be a number between 1 and 65535."
        esc=${name//./\\.}
        grep -qiE "^(# cfdns:begin )?${esc}([[:space:],{]|$)" "$CADDYFILE" && err "$name is already in $CADDYFILE. Use: cfdns site list"
        ss -tln | awk '{print $4}' | grep -qE "[:.]${port}$" || printf "${Y}!${N} Nothing is listening on port %s yet. The site shows 502 until your app starts.\n" "$port"
        confirm "make $name live (DNS record + Caddy → localhost:$port + HTTPS certificate)" || { echo "Cancelled."; exit 1; }

        printf "${W}[1/3] DNS${N}\n"
        rec=$(cf "$API/zones/$Z/dns_records?name=$name&type=A" | jq -c '.result[0] // empty')
        if [ -n "$rec" ]; then
          rid_=$(echo "$rec" | jq -r '.id'); ip=$(echo "$rec" | jq -r '.content'); was=$(echo "$rec" | jq -r '.proxied')
          printf "${G}✓${N} A record already exists (%s)\n" "$ip"
          if [ "$was" = true ]; then set_proxy "$rid_" false; printf "${Y}!${N} Switched to DNS only while the certificate is issued\n"; fi
        else
          ip=$(vps_ip)
          resp=$(cf -X POST "$API/zones/$Z/dns_records" --data "$(jq -n --arg n "$name" --arg c "$ip" '{type:"A",name:$n,content:$c,proxied:false,ttl:1}')")
          echo "$resp" | res "Added A $name → $ip [DNS only]"
          rid_=$(echo "$resp" | jq -r '.result.id')
        fi

        printf "${W}[2/3] Caddy${N}\n"
        caddy_backup
        {
          echo ""
          echo "# cfdns:begin $name"
          echo "$name {"
          echo "    reverse_proxy localhost:$port"
          echo "}"
          echo "# cfdns:end $name"
        } >> "$CADDYFILE"
        caddy_apply
        printf "${G}✓${N} %s → localhost:%s\n" "$name" "$port"

        printf "${W}[3/3] HTTPS certificate${N}\n"
        certfail=""
        if wait_cert "$name" "$ip" 90; then
          printf "${G}✓${N} Certificate is valid for %s\n" "$name"
        else
          certfail=1
          printf "${R}✗${N} Certificate is not ready yet\n"
          cert_diag "$name"
        fi

        if [ "$PROXY" = true ]; then
          if [ -n "$certfail" ]; then
            printf "${Y}!${N} Staying on DNS only until the certificate works. Then run: cfdns proxy %s on\n" "$name"
          else
            set_proxy "$rid_" true
            printf "  checking the orange cloud"
            rc=0; proxy_check "$name" "$ip" || rc=$?
            printf "\n"
            case "$rc" in
              0) printf "${G}✓${N} Proxied (orange cloud) and working\n" ;;
              1) set_proxy "$rid_" false
                 printf "${R}✗${N} Cloudflare redirected the proxied site to %s. Reverted to DNS only.\n" "$PCHECK_LOC"
                 printf "${D}   Look for a Redirect Rule, Page Rule or Workers Route on the zone.${N}\n" ;;
              *) printf "${Y}!${N} Could not verify the orange cloud yet. Test it, and if it misbehaves run: cfdns proxy %s off\n" "$name" ;;
            esac
          fi
        fi
        echo
        printf "${W}Site:${N} ${C}https://%s${N}\n" "$name" ;;
      remove|rm)
        parse "${args[@]}"
        name=$(fqdn "${POS[0]:?usage: cfdns site remove NAME [--keep-dns]}")
        esc=${name//./\\.}
        grep -q "^# cfdns:begin ${esc}\$" "$CADDYFILE" || err "$name was not added by 'cfdns site', so it is not removed automatically. Edit $CADDYFILE by hand."
        if [ -n "$KEEP" ]; then confirm "remove $name from Caddy (DNS kept)" || { echo "Cancelled."; exit 1; }
        else confirm "remove $name from Caddy and delete its DNS A record" || { echo "Cancelled."; exit 1; }; fi
        caddy_backup
        sed -i "/^# cfdns:begin ${esc}\$/,/^# cfdns:end ${esc}\$/d" "$CADDYFILE"
        caddy_apply
        printf "${G}✓${N} Caddy: removed %s\n" "$name"
        if [ -z "$KEEP" ]; then
          id=$(cf "$API/zones/$Z/dns_records?name=$name&type=A" | jq -r '.result[0].id // empty')
          if [ -n "$id" ]; then cf -X DELETE "$API/zones/$Z/dns_records/$id" | res "DNS: deleted A $name"
          else printf "${D}DNS: no A record found for %s${N}\n" "$name"; fi
        fi ;;
      list|ls)
        printf "${W}Sites managed by cfdns${N}\n"
        out=$(awk '/^# cfdns:begin /{h=$3} h && /reverse_proxy/{print h"\t"$2; h=""}' "$CADDYFILE")
        if [ -z "$out" ]; then echo "(none yet)"; else printf "%s\n" "$out" | { column -t -s $'\t' 2>/dev/null || cat; }; fi ;;
    esac ;;
  *)
    banner
    echo
    printf "${W}Usage:${N} cfdns <command>\n\n"
    printf "  ${C}verify${N}                          check token and zone\n"
    printf "  ${C}list${N}                            show all records\n"
    printf "  ${C}add${N} NAME [VALUE] [flags]         create a record\n"
    printf "  ${C}update${N} NAME NEWVALUE [flags]    change a record\n"
    printf "  ${C}proxy${N} NAME [on|off]             show or switch the proxy\n"
    printf "  ${C}delete${N} NAME [flags]             remove a record\n"
    printf "  ${C}site${N} NAME PORT [--proxy]        DNS + Caddy + HTTPS, go live\n"
    printf "  ${C}site remove${N} NAME [--keep-dns]   take a site down\n"
    printf "  ${C}site list${N}                       show managed sites\n"
    printf "  ${C}cert${N} NAME [--retry]             check or retry the certificate\n\n"
    printf "${W}Flags:${N} --type T  --priority N  --match TEXT\n"
    printf "       --proxy  --dns-only  --keep-dns  --retry\n\n"
    printf "${D}NAME can be short (api), full (api.%s) or @ for root.${N}\n" "$ZONE" ;;
esac
