#!/usr/bin/env bash
set -euo pipefail
source /root/.cfdns.env
API="https://api.cloudflare.com/client/v4"
Z="$CLOUDFLARE_ZONE_ID"
cf() { curl -s -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" -H "Content-Type: application/json" "$@"; }
rid() { cf "$API/zones/$Z/dns_records?name=$1" | jq -r '.result[0].id // empty'; }
confirm() { read -rp "Are you sure you want to $1? (type yes to continue): " ans; [ "$ans" = "yes" ]; }

ZONE=$(cf "$API/zones/$Z" | jq -r '.result.name // empty')
[ -z "$ZONE" ] && { echo "Could not read your zone. Check your token and Zone ID with: cfdns verify"; exit 1; }

# test -> test.zone | @ -> zone | name.zone -> as is | anything else -> refused
fqdn() {
  local n="${1,,}"; n="${n%.}"
  if [ "$n" = "@" ] || [ "$n" = "$ZONE" ]; then echo "$ZONE"
  elif [[ "$n" == *".$ZONE" ]]; then echo "$n"
  elif [[ "$n" != *.* ]]; then echo "$n.$ZONE"
  else echo "Refusing: '$1' is outside your zone ($ZONE)." >&2; exit 1
  fi
}

case "${1:-}" in
  verify)
    cf "$API/user/tokens/verify" | jq '{success, status: .result.status}'
    echo "Zone: $ZONE" ;;
  list)
    cf "$API/zones/$Z/dns_records?per_page=100" | jq -r '.result[] | "\(.type)\t\(.name)\t\(.content)\tproxied=\(.proxied)"' ;;
  add)
    name=$(fqdn "${2:?usage: cfdns add NAME [CONTENT] [TYPE] [PROXIED]}")
    content=${3:-$(curl -s https://api.ipify.org)}
    type=${4:-A}; proxied=${5:-true}
    echo "Adding $name -> $content"
    cf -X POST "$API/zones/$Z/dns_records" --data "$(jq -n --arg t "$type" --arg n "$name" --arg c "$content" --argjson p "$proxied" '{type:$t,name:$n,content:$c,proxied:$p,ttl:1}')" | jq '{success, errors, name: .result.name, content: .result.content}' ;;
  update)
    name=$(fqdn "${2:?usage: cfdns update NAME CONTENT}"); content=${3:?missing CONTENT}
    confirm "update $name to $content" || { echo "Cancelled."; exit 1; }
    id=$(rid "$name"); [ -z "$id" ] && { echo "Not found: $name"; exit 1; }
    cf -X PATCH "$API/zones/$Z/dns_records/$id" --data "$(jq -n --arg c "$content" '{content:$c}')" | jq '{success, errors}' ;;
  delete)
    name=$(fqdn "${2:?usage: cfdns delete NAME}")
    confirm "delete $name" || { echo "Cancelled."; exit 1; }
    id=$(rid "$name"); [ -z "$id" ] && { echo "Not found: $name"; exit 1; }
    cf -X DELETE "$API/zones/$Z/dns_records/$id" | jq '{success, errors}' ;;
  *)
    echo "Usage: cfdns {verify|list|add NAME [CONTENT] [TYPE] [PROXIED]|update NAME CONTENT|delete NAME}"
    echo "NAME can be short (api), full (api.$ZONE), or @ for the root." ;;
esac
